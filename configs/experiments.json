{
    "experiments": [
        {
            "EXPERIMENT_DURATION": 300,
            "PROJECT": "prometheus-benchmarking-app",
            "REGION": "us-central1",
            "ZONE" : "us-central1-a",
            "load_generators": {
                "count": 3,
                "envs": [
                    {
                        "START_PORT": 8000,
                        "NUM_TARGETS": 5,
                        "SEED": 42
                    },
                    {
                        "START_PORT": 8000,
                        "NUM_TARGETS": 5,
                        "SEED": 42
                    },
                    {
                        "START_PORT": 8000,
                        "NUM_TARGETS": 5,
                        "SEED": 42
                    }
                ]
            },
            "prometheus_instances": {
                "count": 3,
                "env": {
                    "SCRAPE_INTERVAL": "1s"
                }
            },
            "query_components": {
                "count": 1,
                "envs": [
                    {
                        "QUERY_LIST": ["rate(metric_0[1m])", "rate(metric_1[1m])"],
                        "QUERY_INTERVAL": 1,
                        "SEED": 42
                    }
                ]
            }
        }
    ]
}
